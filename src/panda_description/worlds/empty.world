<?xml version="1.0"?>
<sdf version="1.9">

  <world name="empty_world">

    <!-- ========================================================= -->
    <!-- WORLD PHYSICS                                             -->
    <!-- ========================================================= -->

    <gravity>0 0 -9.8</gravity>

    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>

    <atmosphere type="adiabatic"/>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>


    <!-- ========================================================= -->
    <!-- SCENE                                                      -->
    <!-- ========================================================= -->

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>


    <!-- ========================================================= -->
    <!-- RED BOX                                                     -->
    <!-- ========================================================= -->

    <model name="red_box">

      <static>false</static>

      <pose>0.6 0.6 0.70 0 0 0</pose>

      <link name="red_link">

        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.000075</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.000075</iyy>
            <iyz>0</iyz>
            <izz>0.000060</izz>
          </inertia>
        </inertial>

        <collision name="red_collision">

          <geometry>
            <box>
              <size>0.06 0.06 0.10</size>
            </box>
          </geometry>

          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>

        </collision>

        <visual name="red_visual">

          <geometry>
            <box>
              <size>0.06 0.06 0.10</size>
            </box>
          </geometry>

          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- ========================================================= -->
    <!-- GREEN BOX                                                   -->
    <!-- ========================================================= -->

    <model name="green_box">

      <static>false</static>

      <pose>0.8 0.6 0.70 0 0 0</pose>

      <link name="green_link">

        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.000075</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.000075</iyy>
            <iyz>0</iyz>
            <izz>0.000060</izz>
          </inertia>
        </inertial>

        <collision name="green_collision">

          <geometry>
            <box>
              <size>0.06 0.06 0.10</size>
            </box>
          </geometry>

          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>

        </collision>

        <visual name="green_visual">

          <geometry>
            <box>
              <size>0.06 0.06 0.10</size>
            </box>
          </geometry>

          <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- ========================================================= -->
    <!-- BLUE BOX                                                    -->
    <!-- ========================================================= -->

    <model name="blue_box">

      <static>false</static>

      <pose>0.4 0.6 0.70 0 0 0</pose>

      <link name="blue_link">

        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.000075</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.000075</iyy>
            <iyz>0</iyz>
            <izz>0.000060</izz>
          </inertia>
        </inertial>

        <collision name="blue_collision">

          <geometry>
            <box>
              <size>0.06 0.06 0.10</size>
            </box>
          </geometry>

          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>

        </collision>

        <visual name="blue_visual">

          <geometry>
            <box>
              <size>0.06 0.06 0.10</size>
            </box>
          </geometry>

          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- ========================================================= -->
    <!-- TRASH BIN                                                   -->
    <!-- ========================================================= -->

    <model name="Trash_01_001">

      <static>true</static>

      <include>
        <uri>model://aws_robomaker_residential_Trash_01</uri>
      </include>

      <pose>0.6 -0.6 0.0 0 0 0</pose>

    </model>


    <!-- ========================================================= -->
    <!-- COFFEE TABLE 1                                              -->
    <!-- ========================================================= -->

    <model name="CoffeeTable_1">

      <static>true</static>

      <pose>0 0 0.041983 0 0 0</pose>

      <link name="link">

        <!--
          Simple primitive collision.
          The original COLLADA collision mesh was causing:

          Unable to load collada file
          Missing COLLADA tag

          Therefore we use a box collision instead.
        -->

        <collision name="collision">

          <geometry>
            <box>
              <size>1.25 0.65 0.10</size>
            </box>
          </geometry>

          <surface>
            <contact>
              <ode>
                <max_vel>0.01</max_vel>
              </ode>
            </contact>

            <friction>
              <ode>
                <mu>0.6</mu>
                <mu2>0.6</mu2>
              </ode>
            </friction>
          </surface>

        </collision>


        <!-- Realistic visual mesh -->

        <visual name="visual">

          <geometry>
            <mesh>
              <uri>
                model://aws_robomaker_residential_CoffeeTable_01/meshes/aws_CoffeeTable_01_visual.DAE
              </uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>

        </visual>

      </link>

    </model>


    <!-- ========================================================= -->
    <!-- COFFEE TABLE 2                                              -->
    <!-- ========================================================= -->

    <model name="CoffeeTable_2">

      <static>true</static>

      <pose>1.2577 0 0.041983 0 0 0</pose>

      <link name="link">

        <collision name="collision">

          <geometry>
            <box>
              <size>1.25 0.65 0.10</size>
            </box>
          </geometry>

          <surface>
            <contact>
              <ode>
                <max_vel>0.01</max_vel>
              </ode>
            </contact>

            <friction>
              <ode>
                <mu>0.6</mu>
                <mu2>0.6</mu2>
              </ode>
            </friction>
          </surface>

        </collision>


        <visual name="visual">

          <geometry>
            <mesh>
              <uri>
                model://aws_robomaker_residential_CoffeeTable_01/meshes/aws_CoffeeTable_01_visual.DAE
              </uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>

        </visual>

      </link>

    </model>


    <!-- ========================================================= -->
    <!-- COFFEE TABLE 3                                              -->
    <!-- ========================================================= -->

    <model name="CoffeeTable_3">

      <static>true</static>

      <pose>1.26554 0.637963 0.041983 0 0 0</pose>

      <link name="link">

        <collision name="collision">

          <geometry>
            <box>
              <size>1.25 0.65 0.10</size>
            </box>
          </geometry>

          <surface>
            <contact>
              <ode>
                <max_vel>0.01</max_vel>
              </ode>
            </contact>

            <friction>
              <ode>
                <mu>0.6</mu>
                <mu2>0.6</mu2>
              </ode>
            </friction>
          </surface>

        </collision>


        <visual name="visual">

          <geometry>
            <mesh>
              <uri>
                model://aws_robomaker_residential_CoffeeTable_01/meshes/aws_CoffeeTable_01_visual.DAE
              </uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>

        </visual>

      </link>

    </model>


    <!-- ========================================================= -->
    <!-- COFFEE TABLE 4                                              -->
    <!-- ========================================================= -->

    <model name="CoffeeTable_4">

      <static>true</static>

      <pose>-0.008642 0.643146 0.041983 0 0 0</pose>

      <link name="link">

        <collision name="collision">

          <geometry>
            <box>
              <size>1.25 0.65 0.10</size>
            </box>
          </geometry>

          <surface>
            <contact>
              <ode>
                <max_vel>0.01</max_vel>
              </ode>
            </contact>

            <friction>
              <ode>
                <mu>0.6</mu>
                <mu2>0.6</mu2>
              </ode>
            </friction>
          </surface>

        </collision>


        <visual name="visual">

          <geometry>
            <mesh>
              <uri>
                model://aws_robomaker_residential_CoffeeTable_01/meshes/aws_CoffeeTable_01_visual.DAE
              </uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>

        </visual>

      </link>

    </model>


    <!-- ========================================================= -->
    <!-- GROUND PLANE                                                -->
    <!-- ========================================================= -->

    <model name="ground_plane">

      <static>true</static>

      <link name="link">

        <collision name="collision">

          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>

          <surface>

            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>

            <bounce/>

            <contact/>

          </surface>

        </collision>


        <visual name="visual">

          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>

          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>

        </visual>

      </link>

    </model>


    <!-- ========================================================= -->
    <!-- SUN                                                         -->
    <!-- ========================================================= -->

    <light name="sun" type="directional">

      <pose>0 0 10 0 0 0</pose>

      <cast_shadows>true</cast_shadows>

      <intensity>1</intensity>

      <direction>-0.5 0.1 -0.9</direction>

      <diffuse>0.8 0.8 0.8 1</diffuse>

      <specular>0.2 0.2 0.2 1</specular>

      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.9</constant>
        <quadratic>0.001</quadratic>
      </attenuation>

      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>

    </light>

  </world>

</sdf>

